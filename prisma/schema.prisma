// Crewmon 신원/테넌트 레이어 스키마 (ADR: 인증·계정 영속화).
// 범위: User·Store·Membership·Invite (+ Auth.js 표준 테이블). 운영 데이터(출퇴근/스케줄/급여)는
// 당분간 인메모리 store 유지 — operationalId 가 그 crewId 공간으로의 브리지.
// dev=SQLite, prod=Postgres(provider 만 교체). 타입은 Postgres 호환만 사용.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 앱(풀링 URL). Neon 통합이 자동 주입.
  directUrl = env("DATABASE_URL_UNPOOLED") // 마이그레이션 직결. Neon 통합이 자동 주입(수동 매핑 불필요).
}

generator client {
  provider = "prisma-client-js"
}

// ===== Auth.js(NextAuth v5) 표준 모델 =====
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[] // adapter 계약상 유지(JWT 전략이라 실사용 안 함)
  memberships   Membership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ===== Crewmon 신원/테넌트 =====
model Store {
  id            String       @id @default(cuid())
  name          String // 매장명
  bizNumber     String       @unique // 사업자등록번호(숫자만)
  bizVerified   Boolean      @default(false) // 국세청 진위확인 통과 여부(dev=false 허용)
  operationalId String?      @unique // (레거시 데모 브리지) 신규 실매장=null
  joinDate      String? // StoreInfo: 입사일 "YYYY-MM-DD"
  workDays      String? // StoreInfo: 근무요일 라벨
  workTime      String? // StoreInfo: 근무시간 라벨
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  invites       Invite[]
  // 운영 데이터(단일 진실원)
  records       AttendanceRecord[]
  editRequests  EditRequest[]
  schedules     ScheduleEntry[]
  fixedShifts   FixedShift[]
  notifications Notification[]
  profiles      Profile[]
  payslipInputs PayslipInput[]
}

model Membership {
  id            String   @id @default(cuid()) // 신규 실멤버의 crewId 역할
  userId        String
  storeId       String
  role          String // "master" | "crew"
  isManager     Boolean  @default(false)
  hourlyWage    Int      @default(10320) // 멤버별 시급(원)
  operationalId String? // 데모 매핑: crew-minjung/crew-2/... 또는 master-1
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  // perf: identity-repo 의 핫 조회 findFirst({ OR:[{operationalId},{id}] }) — operationalId 브랜치 인덱스.
  // (id 브랜치는 PK 로 이미 커버.) 매 출퇴근/급여/스케줄/매니저토글 경로에서 호출.
  @@index([operationalId])
  @@index([userId, active])
}

model Invite {
  code       String    @id // 6자리(INVITE_CODE_ALPHABET)
  storeId    String
  createdBy  String // 발급 마스터 Membership/User id
  status     String    @default("대기") // "대기" | "사용" | "회수"
  usedByUser String?
  expiresAt  DateTime? // 만료 시각(null=무기한). 기본 발급 시 +INVITE_TTL_DAYS.
  createdAt  DateTime  @default(now())
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ===== 운영 데이터(Prisma 단일 진실원) — crewId = operationalId(데모) ?? membershipId(실멤버) =====

model AttendanceRecord {
  id              String  @id @default(cuid())
  storeId         String
  crewId          String
  date            String // "YYYY-MM-DD"
  status          String // WorkStatus(파생: clockIn/clockOutStatus 조합)
  clockInStatus   String  @default("정상") // 출근 상태: 정상|지각|결근|휴가
  clockOutStatus  String  @default("정상") // 퇴근 상태: 정상|연장
  clockIn         String? // "HH:MM"
  clockOut        String?
  breakMinutes    Int     @default(30)
  breakStart      String?
  breakEnd        String?
  workMinutes     Int     @default(0)
  overtimeMinutes Int     @default(0)
  deductMinutes   Int     @default(0)
  store           Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([crewId, date])
  @@index([storeId])
}

model EditRequest {
  id        String   @id @default(cuid())
  storeId   String
  crewId    String
  date      String
  reason    String
  before    Json // EditRequestChange
  after     Json
  status    String   @default("대기") // "대기" | "수락"
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([crewId])
}

model ScheduleEntry {
  id         String   @id @default(cuid())
  storeId    String
  crewId     String
  date       String
  startTime  String
  endTime    String
  off        Boolean  @default(false)
  createdBy  String
  substitute Boolean  @default(false)
  approval   String? // "대기" | "수락" (대타에만)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([crewId, date])
  @@index([storeId])
}

model FixedShift {
  id        String @id @default(cuid())
  storeId   String
  crewId    String
  weekdays  Int[] // 0=일 … 6=토
  startTime String
  endTime   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([crewId])
}

model Notification {
  id        String   @id @default(cuid())
  storeId   String
  crewId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([crewId])
}

model Profile {
  id            String  @id @default(cuid())
  storeId       String
  crewId        String  @unique
  name          String
  birthDate     String  @default("")
  phone         String  @default("")
  email         String  @default("")
  avatarInitial String  @default("?")
  store         Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// 급여명세서 입력값(월별, 멤버별). 마스터만 기록, 멤버는 읽기. 도출 불가 항목 보관.
model PayslipInput {
  id               String  @id @default(cuid())
  storeId          String
  crewId           String
  month            String // "YYYY-MM"
  incentiveEnabled Boolean @default(false) // 1% 인센티브 선택 여부
  monthlySales     Int     @default(0) // 총매출(원) → 인센티브 = ×1%
  incomeTax        Int     @default(0) // 근로소득세(간이세액표값, 원)
  nightPay         Int     @default(0) // 야간수당(원)
  store            Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([crewId, month])
  @@index([storeId])
}
