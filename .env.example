# Crewmon 환경변수 템플릿 — 실제 값은 .env(.gitignore)에 둔다.

# DB = Postgres. 앱은 DATABASE_URL(풀링) + DIRECT_URL(직결, 마이그레이션)만 읽는다.
# 로컬 dev: docker compose up -d (localhost:5433).
# prod(Vercel): DB 통합이 주입하는 값을 아래 두 키에 매핑(둘 다 Vercel 환경변수로 설정):
#   - Vercel Postgres(legacy): POSTGRES_PRISMA_URL → DATABASE_URL, POSTGRES_URL_NON_POOLING → DIRECT_URL
#   - Neon 통합:               DATABASE_URL(그대로), DATABASE_URL_UNPOOLED → DIRECT_URL
# 자세한 단계는 DEPLOY.md 참고.
DATABASE_URL="postgresql://ttok:ttok@localhost:5433/ttok?schema=public"
DIRECT_URL="postgresql://ttok:ttok@localhost:5433/ttok?schema=public"

# Auth.js(NextAuth v5). 생성: pnpm dlx auth secret. prod 에서 필수(미설정 시 로그인 동작 안 함).
AUTH_SECRET="change-me"

# loc/dev 전용 우회 로그인 활성화(1). prod(NODE_ENV=production)에서는 코드가 이중 차단 →
# prod 로그인은 Google OAuth 필요. prod 환경변수에는 넣지 말 것(0 또는 미설정).
AUTH_DEV_LOGIN="1"

# Google OAuth — prod 로그인 수단. 발급 후 채우면 실제 구글 로그인 동작.
# 승인 리디렉션 URI(prod): https://<your-app>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 사업자번호 검증 모드: off(dev·아무 번호 허용) | checksum | nts(국세청 진위확인)
BIZ_VALIDATION="off"
# NTS 진위확인 서비스키(prod, BIZ_VALIDATION=nts 일 때)
NTS_SERVICE_KEY=""
