# Crewmon 환경변수 템플릿 — 실제 값은 .env(.gitignore)에 둔다.

# DB = Postgres(approach A: dev·prod 동일 provider).
# 로컬 dev: docker compose up -d (localhost:5433). prod(Vercel): Storage→Postgres가 주입하는
# POSTGRES_PRISMA_URL → DATABASE_URL, POSTGRES_URL_NON_POOLING → DIRECT_URL 로 매핑.
DATABASE_URL="postgresql://ttok:ttok@localhost:5433/ttok?schema=public"
DIRECT_URL="postgresql://ttok:ttok@localhost:5433/ttok?schema=public"

# Auth.js(NextAuth v5). 생성: pnpm dlx auth secret
AUTH_SECRET="change-me"

# loc/dev 전용 우회 로그인 활성화(1). prod 에서는 제거/0 — 코드에서도 NODE_ENV 로 이중 차단.
AUTH_DEV_LOGIN="1"

# Google OAuth — 발급 후 채우면 실제 구글 로그인 즉시 동작.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 사업자번호 검증 모드: off(dev·아무 번호 허용) | checksum | nts(국세청 진위확인)
BIZ_VALIDATION="off"
# NTS 진위확인 서비스키(prod, BIZ_VALIDATION=nts 일 때)
NTS_SERVICE_KEY=""
