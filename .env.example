# Crewmon 환경변수 템플릿 — 실제 값은 .env(.gitignore)에 둔다.

# DB = Postgres. 앱은 DATABASE_URL(풀링) + DATABASE_URL_UNPOOLED(직결, 마이그레이션)을 읽는다.
# 이 두 키는 Neon(Vercel 통합)이 prod 에 "자동 주입"하는 이름과 동일 → prod 수동 매핑 불필요.
# 로컬 dev: docker compose up -d (localhost:5433) → 둘 다 같은 로컬 URL 로 둔다.
DATABASE_URL="postgresql://ttok:ttok@localhost:5433/ttok?schema=public"
DATABASE_URL_UNPOOLED="postgresql://ttok:ttok@localhost:5433/ttok?schema=public"

# Auth.js(NextAuth v5). 생성: pnpm dlx auth secret. prod 에서 필수(미설정 시 로그인 동작 안 함).
AUTH_SECRET="change-me"

# loc/dev 전용 우회 로그인 활성화(1). prod(NODE_ENV=production)에서는 코드가 이중 차단 →
# prod 로그인은 Google OAuth 필요. prod 환경변수에는 넣지 말 것(0 또는 미설정).
AUTH_DEV_LOGIN="1"

# Google OAuth — prod 로그인 수단. 발급 후 채우면 실제 구글 로그인 동작.
# 주의: 구글은 카톡/네이버 등 "인앱 브라우저" 안에서의 로그인을 차단(disallowed_useragent).
# 일반 브라우저(사파리/크롬)에서만 동작 → 인앱 브라우저 대비용으로 카카오 로그인을 함께 제공.
# 승인 리디렉션 URI(prod): https://<your-app>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kakao 로그인 — 카카오톡 인앱 브라우저 안에서도 동작(구글이 막히는 환경 대응).
# 발급: developers.kakao.com → 앱 생성 → [카카오 로그인] 활성화 ON.
#   KAKAO_CLIENT_ID     = [앱 키] REST API 키
#   KAKAO_CLIENT_SECRET = [카카오 로그인] > [보안] Client Secret 코드 생성 + 활성화 상태 ON
# 승인 리디렉션 URI 등록(둘 다): [카카오 로그인] > [Redirect URI]
#   로컬: http://localhost:3000/api/auth/callback/kakao
#   prod: https://<your-app>.vercel.app/api/auth/callback/kakao
# 동의항목: 카카오 email 은 선택 동의(미동의 시 email null → 구글과 자동 링크 안 됨, 별도 계정).
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# 사업자번호 검증 모드: off(dev·아무 번호 허용) | checksum | nts(국세청 진위확인)
BIZ_VALIDATION="off"
# NTS 진위확인 서비스키(prod, BIZ_VALIDATION=nts 일 때)
NTS_SERVICE_KEY=""
